# Set this to true only after the production API and Supabase migration are ready.
VITE_RAPPUZZLE_LIVE=false

# Server-only variables. Never prefix secret values with VITE_.
FARCASTER_APP_DOMAIN=your-production-domain.example
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
